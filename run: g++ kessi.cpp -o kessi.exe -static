name: Build Tugas 6
on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Compile C++
        run: g++ kessi.cpp -o kessi.exe -static

      - name: Upload EXE
        uses: actions/upload-artifact@v4
        with:
          name: tugas-6
          path: kessi.exe
